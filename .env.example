# Django Secret Key (generate a strong unique key for production)
SECRET_KEY=django-insecure-your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=False

# Allowed Hosts (comma-separated list of domains)
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CSRF Trusted Origins (comma-separated list of origins with https://)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,http://localhost:8000

# Supabase PostgreSQL Database URL
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
